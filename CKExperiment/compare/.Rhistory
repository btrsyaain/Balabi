library("survival")
library("timeROC")
data <- read.csv("./67_33ModelmPRLrAUFAB.csv")
testset <- subset(data,Derivation_or_Validation_group==2)
timelist <- c(156,260,416,520)
ROC.pageb <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$PAGE.B,
cause = 1,
times = timelist,
iid = TRUE)
ROC.mpageb <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$mPAGE.B,
cause = 1,
times = timelist,
iid = TRUE)
ROC.reachb <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$REACH.B,
cause = 1,
times = timelist,
iid = TRUE)
ROC.planb <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$PLAN_B_score,
cause = 1,
times = timelist,
iid = TRUE)
ROC.planbretrain <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$PLAN_B_retrain_score,
cause = 1,
times = timelist,
iid = TRUE)
ROC.apab <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$APA.B,
cause = 1,
times = timelist,
iid = TRUE)
ROC.cuhcc <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$CU.HCC,
cause = 1,
times = timelist,
iid = TRUE)
ROC.oursFirst <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$oursFirst,
cause = 1,
times = timelist,
iid = TRUE)
ROC.oursALL <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$oursALL,
cause = 1,
times = timelist,
iid = TRUE)
ROC.oursBASELINE <- timeROC(T = testset$HCCdurationwks,
delta = testset$HCC,
marker = testset$oursBASELINE,
cause = 1,
times = timelist,
iid = TRUE)
ROC.oursALL
ROC.oursFirst
ROC.oursBASELINE
ROC.pageb
ROC.mpageb
ROC.planbretrain
compare(ROC.pageb,ROC.oursALL,adjusted = TRUE)
compare(ROC.mpageb,ROC.oursALL,adjusted = TRUE)
compare(ROC.reachb,ROC.oursALL,adjusted = TRUE)
compare(ROC.planb,ROC.oursALL,adjusted = TRUE)
compare(ROC.planbretrain,ROC.oursALL,adjusted = TRUE)
compare(ROC.apab,ROC.oursALL,adjusted = TRUE)
compare(ROC.cuhcc,ROC.oursALL,adjusted = TRUE)
compare(ROC.pageb,ROC.oursFirst,adjusted = TRUE)
compare(ROC.mpageb,ROC.oursFirst,adjusted = TRUE)
compare(ROC.reachb,ROC.oursFirst,adjusted = TRUE)
compare(ROC.planb,ROC.oursFirst,adjusted = TRUE)
compare(ROC.planbretrain,ROC.oursFirst,adjusted = TRUE)
compare(ROC.apab,ROC.oursFirst,adjusted = TRUE)
compare(ROC.cuhcc,ROC.oursFirst,adjusted = TRUE)
compare(ROC.pageb,ROC.oursBASELINE,adjusted = TRUE)
compare(ROC.mpageb,ROC.oursBASELINE,adjusted = TRUE)
compare(ROC.reachb,ROC.oursBASELINE,adjusted = TRUE)
compare(ROC.planb,ROC.oursBASELINE,adjusted = TRUE)
compare(ROC.planbretrain,ROC.oursBASELINE,adjusted = TRUE)
pare(ROC.apab,ROC.oursBASELINE,adjusted = TRUE)
compare(ROC.apab,ROC.oursBASELINE,adjusted = TRUE)
compare(ROC.cuhcc,ROC.oursBASELINE,adjusted = TRUE)
compare(ROC.oursALL,ROC.oursFirst,adjusted = TRUE)
compare(ROC.oursALL,ROC.oursBASELINE,adjusted = TRUE)
compare(ROC.oursFirst,ROC.oursBASELINE,adjusted = TRUE)
plot(ROC.oursALL,time=156,col = "red")
plot(ROC.oursFirst,time=156,col = "blue")
plot(ROC.oursBASELINE,time=156, col = "black")
legend("bottomright",c("Baseline+1yr","1yr","Baseline"),
col=c("red","blue","black"),lty=1:3)
plot(ROC.oursALL,time=156,col = "red",lwd=2)
plot(ROC.oursFirst,time=156,col = "blue",add=TRUE,lwd=2,lty=2)
plot(ROC.oursBASELINE,time=156, col = "black",add=TRUE,lwd=2,lty=3)
legend("bottomright",c("Baseline+1yr","1yr","Baseline"),
+        col=c("red","blue","black"),lty=1:3)
plot(ROC.oursALL,time=156,col = "red",lwd=2)
